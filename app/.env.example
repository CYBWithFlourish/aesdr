# Cluster the consoles talk to. The seller and arbiter keys live server side.
NEXT_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8899

# Escrow signers. Base58 secret keys, one per role. Never commit real ones.
# Leave blank locally and the app generates persisted dev keys in `app/.keys`.
SELLER_SECRET_KEY=
ARBITER_SECRET_KEY=

# Seller's quoted price. USDC is in base units (6 decimals), SOL in lamports.
SELLER_PRICE_USDC=250000
SELLER_PRICE_SOL=10000000

# Collateral the seller must hold before it can be paid. Always lamports.
SELLER_MIN_BOND=10000000

# Seconds a buyer waits before it can reclaim without anyone's cooperation.
ESCROW_DEADLINE_SECONDS=900

# Required. The seller cannot call a model without it. Get one from
# https://platform.openai.com/api-keys and never commit the real value.
OPENAI_API_KEY=

# Optional overrides. Unset means the official defaults are used
# (https://api.openai.com/v1 and the code's default model). Set either one to
# point this at any OpenAI-compatible gateway or a different model.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Demo lever: force the seller to breach so the arbiter path is visible.
SELLER_FAULT=none
