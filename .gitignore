.anchor
.DS_Store
target
# Local Cargo target used when the default target dir lives on a small tmpfs.
.cargo-target
**/*.rs.bk
node_modules
test-ledger
.yarn
.surfpool
.env
.env.local
*.log

# Build output for the published packages. `@aesdr/client` and `@aesdr/sdk`
# are rebuilt from src by `npm run build`, so compiled JS does not belong in git.
pkgs/*/dist
pkgs/*/*.tsbuildinfo

# Next.js build output and local demo keys. The keys are generated on first run
# and are only valid on a local validator, so they must never be committed.
app/.next
app/next-env.d.ts
app/.keys
app/AGENTS.md
app/tsconfig.tsbuildinfo

# Local demo state written by `npm run setup:demo`: the recorded USDC mint is
# only meaningful against the validator that created it.
app/.local-usdc-mint
