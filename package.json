{
  "name": "aesdr",
  "private": true,
  "license": "GPL-3.0-only",
  "workspaces": [
    "pkgs/*",
    "app"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "postinstall": "npm run build --workspace @aesdr/client && npm run build --workspace @aesdr/sdk",
    "codegen": "node scripts/codegen.mjs",
    "dev": "npm run dev --workspace @aesdr/app",
    "start": "npm run start --workspace @aesdr/app",
    "app:build": "npm run build --workspace @aesdr/app",
    "e2e": "node --experimental-strip-types scripts/e2e-local.mts",
    "e2e:sol": "AESDR_E2E_ASSET=lamports node --experimental-strip-types scripts/e2e-local.mts",
    "setup:demo": "bash scripts/demo-setup.sh",
    "setup:demo:rotate": "bash scripts/demo-setup.sh --override-keys",
    "test": "bash scripts/test-local.sh",
    "lint:fix": "prettier \"pkgs/*/src/**/*.ts\" \"app/src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.mjs\" -w",
    "lint": "prettier \"pkgs/*/src/**/*.ts\" \"app/src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.mjs\" --check"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.6",
    "@codama/renderers-js": "^2.8.0",
    "@solana/kit": "^8.6.0",
    "@solana/program-client-core": "^8.6.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^22.0.0",
    "chai": "^4.3.4",
    "codama": "^1.11.0",
    "mocha": "^11.8.0",
    "prettier": "^2.6.2",
    "ts-mocha": "^11.1.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@solana-program/token": "^0.18.0"
  }
}
